{
  "name": "mception",
  "version": "0.1.0",
  "description": "OAuth 2.1 Reverse Proxy and Gateway for Gemini Spark MCPs",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
