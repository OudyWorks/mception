# MCeption Server Configuration

# Listening port inside container / host
PORT=3000

# Public-facing base URL where Gemini Spark reaches MCeption
# If using a tunnel (e.g. ngrok, cloudflare tunnel): https://mception.yourdomain.com
MCEPTION_PUBLIC_URL=http://localhost:3000

# Secret key used to access the Web Dashboard and Admin REST API
ADMIN_API_KEY=mception-super-secret-admin-key

# Master 32-byte encryption key for AES-256-GCM (64 hex characters or 44 base64 chars)
# If omitted in development, a persistent key is auto-generated in /data/.dev_master_key
# MCEPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Network SSRF protection policy:
# false (default): Allows RFC 1918 private subnets and localhost (for Docker/LAN MCPs)
# true: Strictly blocks RFC 1918 and localhost (recommended for public cloud deployments)
BLOCK_PRIVATE_NETWORKS=false

# Optional comma-separated list of allowed OAuth redirect URI prefixes
# ALLOWED_REDIRECT_URIS=https://gemini.google.com

# SQLite database file path
DATABASE_PATH=./data/mception.db

# Logging level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
